# 本地 AI 的 ONNX 权重（不进仓库，见 tools/fetch-models.sh）。
# 只忽略**仓库根**的 `models/`——否则会连 `crates/local-ai/src/models/`（源码目录）一起忽略。
/models/

# 测试用音频（`tools/make-test-song.py` 生成的合成曲子，本地产物）。
/test-files/

# 头脑风暴可视化伴侣的 mockup 与会话文件（本地临时产物，不进仓库）。
.superpowers/

# 技能工具（Command Code）的本地状态，不进仓库。
.agents/

# WorkBuddy AI 的本地记忆/会话状态，不进仓库。
.workbuddy-ai/

# Command Code 的本地状态（同 `.agents/`），不进仓库。
.commandcode/

# 插件界面诊断（`AIDAW_EDITOR_SELFTEST`）在仓库根留下的 stderr/stdout 产物。
/selftest.err.txt
/selftest.out.txt

# 乐谱自检的本地产物：`.tmp/` 是打包中间文件，`tools/out/` 是生成的 MusicXML 样例。
/.tmp/
/tools/out/
