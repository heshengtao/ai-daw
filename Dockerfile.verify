# 仅用于本机验证（Docker Hub 不可达，用已有的 python:3.12-slim 当同版本 Debian 底）
FROM python:3.12-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config curl ca-certificates \
        libssl-dev libasound2-dev libwebkit2gtk-4.1-dev libgtk-3-dev \
        libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.97.0
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src
COPY . .
RUN cargo build --release -p ai-daw-daemon --bin aidawd && strip /src/target/release/aidawd

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libasound2 libssl3 libwebkit2gtk-4.1-0 libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && find /usr/share/doc /usr/share/man /usr/share/locale -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
COPY --from=builder /src/target/release/aidawd /usr/local/bin/aidawd
ENV AIDAW_DATA_DIR=/data
EXPOSE 28430
ENTRYPOINT ["aidawd", "--data-dir", "/data", "--lan", "--port", "28430"]
