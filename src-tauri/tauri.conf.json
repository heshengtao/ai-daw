{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI DAW",
  "version": "1.6.2",
  "identifier": "com.aidaw.app",
  "build": {
    "beforeDevCommand": "npm run build:sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch:registry && npm run build && npm run build:sidecars",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI DAW",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/aidaw",
      "binaries/vst3-host-helper",
      "binaries/vst3-host-probe",
      "binaries/clap-scan-probe"
    ],
    "resources": {
      "resources/articulation-maps": "articulation-maps",
      "resources/onnx/basic-pitch-nmp.onnx": "models/basic-pitch-nmp.onnx",
      "resources/onnx/localvqe-ns.onnx": "models/localvqe-ns.onnx",
      "resources/onnx/mel_spectrogram.onnx": "models/mel_spectrogram.onnx"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQ0Y3RjQ0QUNFREMyOTYKUldTV3d1MnNSSC9QNE9TYTV4UUxMc3hYdFJxYVE5KzhsaTlPeFRNYVlQQVIxZkVGOWhpcXpkK0gK",
      "endpoints": [
        "https://github.com/heshengtao/ai-daw/releases/latest/download/latest.json"
      ]
    }
  }
}
